int game(int maxnum) {
    srand(time(0));
    int luku;
    int oikeaLuku = rand() % maxnum + 1;
    int arvaustenMaara = 0;

    do {
        cout << "Anna luku: ";
        cin >> luku;
        arvaustenMaara++;

        if (oikeaLuku < luku) {
            cout << "Liian suuri" << endl;
        }
        else if (oikeaLuku > luku) {
            cout << "Liian pieni" << endl;
        }

    } while (luku != oikeaLuku);

    cout << "Oikein!" << endl;
    return arvaustenMaara;
}

int main() {
    int arvaukset = game(40);
    cout << arvaukset << " yritysta." << endl;
    return 0;
}

    